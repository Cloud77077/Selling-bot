# Telegram bot token from @BotFather.
BOT_TOKEN=123456:telegram-bot-token

# Comma-separated numeric Telegram user IDs that can use admin bot commands and receive payment alerts.
ADMIN_IDS=123456789,987654321

# Defaults to the PostgreSQL container in docker-compose.yml. Usually do not change this on a VPS install.
DATABASE_URL=postgresql+psycopg://selling_bot:selling_bot@postgres:5432/selling_bot

# Long random string used to sign admin-panel browser sessions.
SECRET_KEY=replace-with-long-random-string

# Local upload directory mounted into the admin panel and nginx containers.
UPLOAD_DIR=admin_panel/static/uploads

# Payment settings shown to buyers or saved in the admin settings page.
UPI_ID=yourname@upi
UPI_PAYEE_NAME=Your Name
BINANCE_PAY_QR_PATH=/static/uploads/binance-qr.png

# Pending orders older than this are automatically marked expired by the bot.
ORDER_EXPIRY_MINUTES=30

# Admins are alerted when stock crosses from above this number to this number or below.
LOW_STOCK_THRESHOLD=5

# Domain and email used by the documented Certbot SSL setup.
PUBLIC_DOMAIN=example.com
CERTBOT_EMAIL=you@example.com
