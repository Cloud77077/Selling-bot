# Telegram bot token from @BotFather
BOT_TOKEN=123456:telegram-bot-token
# Comma-separated numeric Telegram IDs allowed to administer the bot
ADMIN_IDS=123456789,987654321
# In-VPS Postgres container URL. Beginners should leave this unchanged.
DATABASE_URL=postgresql+psycopg://selling_bot:selling_bot@postgres:5432/selling_bot
# Long random secret for admin panel sessions
SESSION_SECRET_KEY=replace-with-long-random-string
# Local media folder mounted into bot/admin/nginx containers
UPLOAD_DIR=media/uploads
# UPI settings shown to buyers
UPI_ID=yourname@upi
UPI_PAYEE_NAME=Your Shop Name
# Local path/text for Binance Pay QR uploaded in admin panel
BINANCE_PAY_QR_PATH=/media/uploads/binance-qr.png
# Pending orders older than this many minutes are expired by the bot background task
ORDER_EXPIRY_MINUTES=30
# Admins get an alert when unused stock crosses down to this number
LOW_STOCK_THRESHOLD=3
# Domain and email used by the dockerized certbot SSL setup
DOMAIN_NAME=example.com
CERTBOT_EMAIL=admin@example.com
